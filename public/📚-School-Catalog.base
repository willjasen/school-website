filters:
  and:
    - file.ext == "md"
views:
  - type: table
    name: All school notes
    filters:
      and:
        - file.path.startsWith("School/")
    order:
      - file.name
      - file.folder
      - file.tags
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
    columnSize:
      file.name: 340
      file.folder: 420
      note.tags: 180
  - type: table
    name: College
    filters:
      and:
        - file.path.startsWith("School/🏫 College/")
    order:
      - file.name
      - file.folder
      - file.tags
      - file.mtime
    sort:
      - property: file.folder
        direction: ASC
    columnSize:
      file.name: 340
      file.folder: 420
  - type: table
    name: High school
    filters:
      and:
        - file.path.startsWith("School/🚌 High School/")
    order:
      - file.name
      - file.folder
      - file.tags
      - file.mtime
    sort:
      - property: file.folder
        direction: ASC
    columnSize:
      file.name: 340
      file.folder: 420
